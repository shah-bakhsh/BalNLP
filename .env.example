# Copy to .env at the repository root. Public official IDs are revision-pinned in config.py.
HF_TOKEN=
BALPOS_MODEL=shah-bakhsh/BalPOS
BALNER_MODEL=shah-bakhsh/BalNER-v2
BALMORPH_MODEL=shah-bakhsh/BalMorph
BALPARSER_MODEL=shah-bakhsh/BalParser
# Optional commit SHA overrides. Custom repositories default to their main revision.
BALPOS_REVISION=
BALNER_REVISION=
BALMORPH_REVISION=
BALPARSER_REVISION=
# Verified notebook adapter with from_pretrained, predict, unload.
BALMORPH_ADAPTER=balnlp.morph_adapter:NotebookBalMorph
BALNLP_MEMORY_MODE=low
BALNLP_DEVICE=cpu
BALNLP_CPU_THREADS=1
MAX_TEXT_LENGTH=2000
MAX_TOKENS=256
MAX_SUBWORDS=512
MAX_PARSER_WORDS=80
MODEL_LOAD_ATTEMPTS=2
FRONTEND_URL=http://localhost:3000
REQUEST_TIMEOUT_SECONDS=180
MAX_REQUEST_BYTES=32768
BODY_TIMEOUT_SECONDS=15
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=10
PORT=8000
# Copy these NEXT_PUBLIC settings into frontend/.env.local (all public, no credentials).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_MAX_TEXT_LENGTH=2000
NEXT_PUBLIC_GITHUB_URL=

ENABLE_POS=true
ENABLE_NER=true
ENABLE_MORPH=true
ENABLE_PARSER=true
BALNLP_WARMUP=false
# Set to actual host/container limit; auto-detects Linux cgroups when omitted.
# BALNLP_MEMORY_LIMIT_MB=512
